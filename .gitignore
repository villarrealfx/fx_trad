# ============================================
target/
Cargo.lock
**/*.rs.bk
*.pdb

# ============================================
# PHP
# ============================================
vendor/
composer.lock
.phpunit.result.cache
.php-cs-fixer.cache

# ============================================
# Ruby
# ============================================
*.gem
.bundle/
vendor/bundle
Gemfile.lock
.rspec_status

# ============================================
# Entornos y secretos (CRÍTICO)
# ============================================
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt
*.p12
secrets/
.secrets/
config/secrets.yml
config/credentials.yml.enc
config/master.key

# ============================================
# Bases de datos locales
# ============================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.duckdb
*.duckdb.wal
data/
dump.sql
*.dump

# ============================================
# Logs (NO versionar, pero el contrato sí)
# ============================================
logs/
*.log
! _docs/logging-contract.md

# ============================================
# Docker / K8s (depende de tu setup)
# ============================================
# Si usas override locales:
docker-compose.override.yml
*.kubeconfig

# ============================================
# CI/CD (secretos, no configs)
# ============================================
.github/workflows/*.yml.bak
.gitlab-ci-local/
.circleci/local-*

# ============================================
# Cobertura y reportes
# ============================================
coverage/
reports/
*.coverage
junit.xml
test-results/

# ============================================
# Backups y temporales
# ============================================
*.bak
*.tmp
*.temp
*.orig
*.rej
tmp/
temp/
.cache/

# ============================================
# OpenCode
# ============================================
# NO ignorar .opencode/command/ (son los skills, se versionan)
# .opencode/command/** se VERSIONA
.opencode/sessions/
.opencode/cache/
.opencode/logs/
.opencode/history/
# Copia local del skill: se conserva pero nunca se versiona
.opencode/command/sdd-backlog copy.md