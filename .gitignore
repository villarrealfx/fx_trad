# ============================================
# SDD — Pipeline de especificaciones
# ============================================

# NUNCA ignorar _docs/ (son la fuente de verdad)
# _docs/ SIEMPRE se versiona completa, incluido iterations/
! _docs/**

# Archivos temporales de sesión
.opencode/sessions/
.opencode/cache/
.opencode/logs/

# ============================================
# Sistema operativo
# ============================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ============================================
# Editores / IDEs
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml
*.sublime-workspace
*.sublime-project

