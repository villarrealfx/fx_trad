# Imagen del worker Celery de descargas (TASK-004, ADR-006).
# Mínima para el E2E de dev; TASK-038 (Docker Compose 4 servicios) la
# consolidará junto al backend HTTP y el frontend.
FROM python:3.12-slim

WORKDIR /app

COPY backend/pyproject.toml ./pyproject.toml
COPY backend/src ./src

RUN pip install --no-cache-dir \
    "celery[amqp]>=5,<6" \
    "pydantic>=2.6,<3" \
    "structlog>=24,<26"

ENV PYTHONPATH=/app/src

CMD ["celery", "-A", "fxtrad.ingest.tasks:celery_app", "worker", "--loglevel=info"]